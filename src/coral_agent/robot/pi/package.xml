<?xml version="1.0"?>
<package format="2">
  <name>ainex_demo</name>
  <version>0.1.0</version>
  <description>
    Director demo package for the AiNex robot: the vision, head and body ROS
    nodes, the robot_server HTTP bridge, and the BodyCommand service that
    robot_server uses to drive the body/arm servos.
  </description>

  <maintainer email="sdf72@cornell.edu">Scott Fukuda</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- message_generation builds BodyCommand.srv at build time -->
  <build_depend>message_generation</build_depend>
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>

  <!-- message_runtime is needed by anything importing the generated srv type -->
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
</package>
