<launch>
  <!-- Minimal stack: body.py provides the /body_commands service (hardware
       actuation); server.py is the HTTP bridge that calls it. -->
  <node pkg="ainex_demo" type="body.py"            name="body"           output="screen"/>
  <node pkg="ainex_demo" type="server.py"          name="server"         output="screen"/>
  <!-- <node pkg="ainex_demo" type="head.py"          name="head"         output="screen"/>
  <node pkg="ainex_demo" type="vision.py"        name="vision"       output="screen"/>
  <node pkg="ainex_demo" type="robot_server.py"  name="robot_server" output="screen"/> -->
</launch>
