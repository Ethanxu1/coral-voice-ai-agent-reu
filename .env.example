# Required — LLM motion planner and intent classification.
OPENAI_API_KEY=

# Optional — point the OpenAI SDK at a compatible provider (e.g. DeepSeek).
# Read by the SDK itself, not by our code. Leave unset for OpenAI.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional — LLM tracing and cost tracking.
# Get keys at https://cloud.langfuse.com > Settings > API Keys.
# Leave blank to disable tracing.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Whisper model size for speech-to-text. Supported: tiny, base, small (and
# their .en English-only variants). Defaults to "base.en". Smaller models are
# faster and often more robust for very short commands; larger models are more
# accurate for longer, noisier speech.
WHISPER_MODEL_SIZE=base

ROBOT_IP=192.168.8.219
