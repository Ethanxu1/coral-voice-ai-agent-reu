# Daily.co API key (get one at https://dashboard.daily.co)
DAILY_API_KEY=your_daily_api_key_here

# DeepSeek API key (get one at https://platform.deepseek.com)
# Set OPENAI_BASE_URL to use DeepSeek's OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Daily room URL (if using a specific room)
DAILY_ROOM_URL=

# Langfuse tracing (get keys at https://cloud.langfuse.com > Settings > API Keys)
# Required for LLM observability and cost tracking
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Whisper model size for speech-to-text. Supported: tiny, base, small (and
# their .en English-only variants). Defaults to "base.en". Smaller models are
# faster and often more robust for very short commands; larger models are more
# accurate for longer, noisier speech.
WHISPER_MODEL_SIZE=base
